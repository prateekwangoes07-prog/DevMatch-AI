# FastAPI Configuration
ENV=development
APP_NAME="DevMatch AI Backend"

# Database Configuration
# In docker-compose, this is postgres:5432
POSTGRES_DB=devmatch_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev_123
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_dev_123@postgres:5432/devmatch_db

# Security
JWT_SECRET=super_secret_jwt_key_change_me_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
